{%- assign cdn = 'https://cdn.shopify.com/s/files/1/0713/5382/7412/files' -%}
{%- assign version = 'v=1792067657' -%}

<section class="hero-carousel" data-hero-carousel aria-roledescription="carousel" aria-label="{{ section.settings.label | escape }}">
  <div class="hero-carousel__slide">
    <picture>
      <source media="(max-width: 749px)" srcset="{{ cdn }}/slide-1-mobile.jpg?{{ version }}">
      <img class="hero-carousel__image" src="{{ cdn }}/slide-1-desktop.jpg?{{ version }}" alt="A sand-coloured tent pitched on a grassy mountain ridge at sunrise">
    </picture>
    <div class="hero-carousel__caption">
      <h2 class="hero-carousel__heading">{{ section.settings.heading_1 }}</h2>
      <a class="hero-carousel__link" href="{{ section.settings.link_1 | default: routes.all_products_collection_url }}">{{ section.settings.button_1 }}</a>
    </div>
  </div>
  <div class="hero-carousel__slide">
    <picture>
      <source media="(max-width: 749px)" srcset="{{ cdn }}/slide-2-mobile.jpg?{{ version }}">
      <img class="hero-carousel__image" src="{{ cdn }}/slide-2-desktop.jpg?{{ version }}" alt="A slate-blue daypack resting against a tree stump beside a trail through a pine forest">
    </picture>
    <div class="hero-carousel__caption">
      <h2 class="hero-carousel__heading">{{ section.settings.heading_2 }}</h2>
      <a class="hero-carousel__link" href="{{ section.settings.link_2 | default: routes.all_products_collection_url }}">{{ section.settings.button_2 }}</a>
    </div>
  </div>
  <div class="hero-carousel__slide">
    <picture>
      <source media="(max-width: 749px)" srcset="{{ cdn }}/slide-3-mobile.jpg?{{ version }}">
      <img class="hero-carousel__image" src="{{ cdn }}/slide-3-desktop.jpg?{{ version }}" alt="An olive tent on the shore of a still mountain lake at dusk, peaks reflected in the water">
    </picture>
    <div class="hero-carousel__caption">
      <h2 class="hero-carousel__heading">{{ section.settings.heading_3 }}</h2>
      <a class="hero-carousel__link" href="{{ section.settings.link_3 | default: routes.all_products_collection_url }}">{{ section.settings.button_3 }}</a>
    </div>
  </div>

  <button class="hero-carousel__arrow hero-carousel__arrow--prev" type="button" aria-label="{{ 'general.slider.previous_slide' | t }}">&lsaquo;</button>
  <button class="hero-carousel__arrow hero-carousel__arrow--next" type="button" aria-label="{{ 'general.slider.next_slide' | t }}">&rsaquo;</button>
  <div class="hero-carousel__dots">
    <button class="hero-carousel__dot" type="button" aria-label="1"></button>
    <button class="hero-carousel__dot" type="button" aria-label="2"></button>
    <button class="hero-carousel__dot" type="button" aria-label="3"></button>
  </div>
</section>

{% schema %}
{
  "name": "Hero carousel",
  "settings": [
    { "type": "text", "id": "label", "label": "Carousel label", "default": "Featured collections" },
    { "type": "text", "id": "heading_1", "label": "Heading 1", "default": "Pitch above the clouds" },
    { "type": "text", "id": "button_1", "label": "Button 1", "default": "Shop tents" },
    { "type": "url", "id": "link_1", "label": "Link 1" },
    { "type": "text", "id": "heading_2", "label": "Heading 2", "default": "Carry less, go further" },
    { "type": "text", "id": "button_2", "label": "Button 2", "default": "Shop backpacks" },
    { "type": "url", "id": "link_2", "label": "Link 2" },
    { "type": "text", "id": "heading_3", "label": "Heading 3", "default": "Camp where the view is" },
    { "type": "text", "id": "button_3", "label": "Button 3", "default": "Shop all gear" },
    { "type": "url", "id": "link_3", "label": "Link 3" }
  ],
  "presets": [{ "name": "Hero carousel" }]
}
{% endschema %}
